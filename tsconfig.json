{
  "compilerOptions": {
    /* Node/CJS simple et standard Nest */
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./dist",
    "rootDir": "./src",

    /* TypeScript strict */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Aliases confortables */
    "baseUrl": "./",
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@config/*": ["src/config/*"]
    },

    /* Nest */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Qualité/dev */
    "esModuleInterop": true,
    "isolatedModules": false,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts", "test/app.spec.ts"],
  "exclude": ["node_modules", "dist"]
}
