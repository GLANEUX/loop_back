# Node environment (development, test, production)
NODE_ENV=development

# Application Port (default: 3001)
PORT=3001

# Database Connection URL
# Example: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# JWT Secret for authentication
# Make sure to use a strong, unique secret in production
JWT_SECRET=

# Logging Level (info, debug, warn, error)
LOG_LEVEL=info
